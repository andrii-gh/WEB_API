@model IEnumerable<_01.Models.Product>

@{
    ViewData["Title"] = "Каталог";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1>Каталог товарів</h1>
        <a asp-action="Create" class="btn btn-success">Додати товар</a>
    </div>

    <div class="mb-4">
        <h5>Оберіть категорію:</h5>
        <div class="d-flex flex-wrap gap-2">

            <a asp-action="Index"
               class="btn @(ViewBag.CurrentCategory == null ? "btn-primary" : "btn-outline-primary")">
                Всі товари
            </a>

            @foreach (var category in ViewBag.Categories as List<_01.Models.Category>)
            {
                var isActive = ViewBag.CurrentCategory == category.Name;
                    <a asp-action="Index"
                       asp-route-categoryName="@category.Name"
                       class="btn @(isActive ? "btn-primary" : "btn-outline-primary")">
                    @category.Name
                    </a>
            }
        </div>
    </div>

    <p class="text-muted">Знайдено товарів: <strong>@Model.Count()</strong></p>

    <div class="row mt-4">
        @if (!Model.Any())
        {
                <div class="col-12 alert alert-warning">
                    У цій категорії поки що немає товарів.
                </div>
        }
        else
        {
            @foreach (var product in Model)
            {
                        <div class="col-md-4 mb-4">
                            <div class="card h-100 shadow-sm">
                        @if (!string.IsNullOrEmpty(product.Image))
                        {
                                        <img src="@product.Image" class="card-img-top" alt="@product.Name" style="height: 220px; object-fit: cover;" />
                        }
                        else
                        {
                                        <div class="d-flex align-items-center justify-content-center bg-light" style="height: 220px;">
                                            <span class="text-muted">Фото відсутнє</span>
                                        </div>
                        }

                                <div class="card-body d-flex flex-column">
                                    <span class="badge bg-secondary align-self-start mb-2">
                                @product.Category?.Name
                                    </span>

                                    <h5 class="card-title">@product.Name</h5>
                                    <p class="card-text text-muted flex-grow-1">@product.Description</p>

                                    <div class="d-flex justify-content-between align-items-center mt-3 mb-3">
                                        <span class="h5 mb-0 text-primary">@product.Price ₴</span>
                                        <span class="badge bg-success">@product.Amount шт.</span>
                                    </div>

                                    <div class="d-flex gap-2">
                                        <a asp-action="Edit" asp-route-id="@product.Id" class="btn btn-sm btn-outline-primary w-50">
                                            Редагувати
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@product.Id" class="btn btn-sm btn-outline-danger w-50">
                                            Видалити
                                        </a>
                                    </div>

                                    <a asp-controller="Cart" asp-action="AddToCart" asp-route-id="@product.Id"
                                       class="btn btn-sm btn-success w-100 mt-2">
                                        Додати в кошик
                                    </a>
                                </div>
                            </div>
                        </div>
            }
        }
    </div>
</div>