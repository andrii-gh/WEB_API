@model _01.Models.Product
@{
    ViewData["Title"] = "Редагувати";
}

<h1>Редагувати товар</h1>
<div class="row">
    <div class="col-md-6">
        <form asp-action="Edit" method="post" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="Image" />


            <div class="form-group mb-3">
                <label class="control-label">Поточне фото</label><br />
                @if (!string.IsNullOrEmpty(Model.Image))
                {
                        <img src="@Model.Image" style="max-height:150px;" class="mb-2 rounded" />
                }
                else
                {
                        <p class="text-muted">Фото відсутнє</p>
                }
                <label asp-for="ImageFile" class="control-label mt-2">Замінити фото</label>
                <input asp-for="ImageFile" class="form-control" accept="image/*" />
            </div>


            <div class="form-group">
                <input type="submit" value="Оновити" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-secondary">Назад</a>
            </div>
        </form>
    </div>
</div>
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
 }