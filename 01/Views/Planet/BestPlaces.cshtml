@{
    ViewData["Title"] = "Місця, де я хотів би побувати";
}

<div class="container mt-4">
    <h1>Місця на планеті, де я хотів би побувати</h1>

    <div class="row mt-4">
        <div class="col-md-4 mb-4">
            <div class="card h-100 shadow-sm">
                <img src="~/images/place1.jpg" class="card-img-top" alt="Ісландія" />
                <div class="card-body">
                    <h5 class="card-title">Ісландія</h5>
                    <p class="card-text">
                        Країна вогню та льоду — гейзери, водоспади,
                        північне сяйво та льодовики.
                    </p>
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-4">
            <div class="card h-100 shadow-sm">
                <img src="~/images/place2.jpg" class="card-img-top" alt="Японія" />
                <div class="card-body">
                    <h5 class="card-title">Японія</h5>
                    <p class="card-text">
                        Поєднання стародавніх храмів та сучасних технологій,
                        сакура та гора Фудзі.
                    </p>
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-4">
            <div class="card h-100 shadow-sm">
                <img src="~/images/place3.jpg" class="card-img-top" alt="Нова Зеландія" />
                <div class="card-body">
                    <h5 class="card-title">Нова Зеландія</h5>
                    <p class="card-text">
                        Неймовірні пейзажі, фіорди Мілфорд-Саунд,
                        гори та зелені пагорби.
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>